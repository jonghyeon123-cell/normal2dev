# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 채워 주세요.
# .env.local 은 .gitignore 에 포함되어 GitHub 에 올라가지 않아요.

# Voyage AI - 서버 코드에서만 사용 (NEXT_PUBLIC_ 을 붙이지 마세요)
VOYAGE_API_KEY=

# Supabase - 대시보드의 Project Settings > API Keys 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) - 브라우저에 공개되어도 되는 키, RLS 로 보호돼요
# 예전 프로젝트라면 anon key 를 넣어도 돼요
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) - 서버 전용, 인덱싱 스크립트에서만 사용해요
# 예전 프로젝트라면 service_role key 를 넣어도 돼요. 절대 브라우저로 보내지 마세요
SUPABASE_SECRET_KEY=
